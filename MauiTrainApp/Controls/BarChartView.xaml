<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="MauiTrainApp.Controls.BarChartView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MauiTrainApp.Controls"
    x:Name="Root">

    <HorizontalStackLayout
        x:Name="Bars"
        HorizontalOptions="Center"
        Spacing="{StaticResource Space2}">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="controls:BarChartBar">
                <VerticalStackLayout Spacing="{StaticResource Space1}" WidthRequest="{Binding BarWidth}">
                    <Label
                        FontSize="9"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource Muted}"
                        Text="{Binding ValueText}" />
                    <Grid HeightRequest="{Binding ChartHeight}">
                        <BoxView
                            BackgroundColor="{Binding Fill}"
                            CornerRadius="4"
                            HeightRequest="{Binding BarHeight}"
                            VerticalOptions="End" />
                    </Grid>
                    <Label
                        FontSize="9"
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource Muted}"
                        Text="{Binding Label}" />
                </VerticalStackLayout>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </HorizontalStackLayout>

</ContentView>
