<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiTrainApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiTrainApp.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{StaticResource BackgroundElevated}"
    Shell.TabBarForegroundColor="{StaticResource Accent}"
    Shell.TabBarTitleColor="{StaticResource Accent}"
    Shell.TabBarUnselectedColor="{StaticResource Neutral600}"
    Title="MauiTrainApp">

    <TabBar>
        <ShellContent
            Title="Сегодня"
            ContentTemplate="{DataTemplate views:TodayPage}"
            Route="today" />
        <ShellContent
            Title="Планы"
            ContentTemplate="{DataTemplate views:TrainingPlansPage}"
            Route="plans" />
        <ShellContent
            Title="История"
            ContentTemplate="{DataTemplate views:HistoryPage}"
            Route="history" />
    </TabBar>

</Shell>
