<?xml version="1.0" encoding="utf-8" ?>
<base:ContentPageBase
    x:Class="MauiTrainApp.Views.TrainingPlansPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:MauiTrainApp.Views.Base"
    xmlns:controls="clr-namespace:MauiTrainApp.Controls"
    xmlns:items="clr-namespace:MauiTrainApp.ViewModels.Items"
    xmlns:viewModels="clr-namespace:MauiTrainApp.ViewModels"
    x:DataType="viewModels:TrainingPlansViewModel"
    Title="Планы">

    <Grid RowDefinitions="Auto,*">

        <ActivityIndicator
            Grid.Row="0"
            HeightRequest="3"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}" />

        <VerticalStackLayout
            Grid.Row="1"
            Padding="{StaticResource Space8}"
            IsVisible="{Binding IsEmpty}"
            Spacing="{StaticResource Space4}"
            VerticalOptions="Center">
            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource CardTitle}"
                Text="Планов пока нет" />
            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource Muted}"
                Text="План — это набор упражнений с подходами, с которого начинается тренировка" />
            <Button
                Command="{Binding CreatePlanCommand}"
                Style="{StaticResource PrimaryButton}"
                Text="Создать план" />
            <Button
                Command="{Binding OpenExercisesCommand}"
                Style="{StaticResource GhostButton}"
                Text="Каталог упражнений" />
        </VerticalStackLayout>

        <RefreshView
            Grid.Row="1"
            Command="{Binding LoadCommand}"
            IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
            IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBool}}">

            <ScrollView>
                <VerticalStackLayout Padding="{StaticResource Space6}" Spacing="{StaticResource Space4}">

                    <controls:SectionHeader
                        ActionCommand="{Binding CreatePlanCommand}"
                        ActionText="+ План"
                        Title="Тренировочные планы" />

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding TrainingPlans}"
                        Spacing="{StaticResource Space4}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="items:TrainingPlanRowViewModel">
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="{StaticResource Space3}">

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}">
                                            <VerticalStackLayout Spacing="{StaticResource Space1}">
                                                <Label Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                                                <Label Style="{StaticResource Muted}" Text="{Binding SummaryText}" />
                                                <Label
                                                    IsVisible="{Binding HasSchedule}"
                                                    Style="{StaticResource Muted}"
                                                    Text="{Binding ScheduleText}"
                                                    TextColor="{StaticResource Accent400}" />
                                            </VerticalStackLayout>
                                            <controls:TagChip
                                                Grid.Column="1"
                                                IsVisible="{Binding IsNext}"
                                                Kind="Accent"
                                                Text="Следующий"
                                                VerticalOptions="Start" />
                                        </Grid>

                                        <FlexLayout
                                            BindableLayout.ItemsSource="{Binding ExerciseNames}"
                                            Direction="Row"
                                            Wrap="Wrap">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <controls:TagChip
                                                        Margin="0,0,6,6"
                                                        Kind="Outline"
                                                        Text="{Binding .}" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </FlexLayout>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space3}">
                                            <Button
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:TrainingPlansViewModel}}, Path=StartWorkoutCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource PrimaryButton}"
                                                Text="Начать" />
                                            <Button
                                                Grid.Column="1"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:TrainingPlansViewModel}}, Path=EditPlanCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource SecondaryButton}"
                                                Text="Изменить" />
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button
                        Command="{Binding OpenExercisesCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Text="Каталог упражнений" />

                </VerticalStackLayout>
            </ScrollView>

        </RefreshView>

    </Grid>

</base:ContentPageBase>
