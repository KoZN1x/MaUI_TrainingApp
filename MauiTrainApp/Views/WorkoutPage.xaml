<?xml version="1.0" encoding="utf-8" ?>
<base:ContentPageBase
    x:Class="MauiTrainApp.Views.WorkoutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:MauiTrainApp.Views.Base"
    xmlns:controls="clr-namespace:MauiTrainApp.Controls"
    xmlns:items="clr-namespace:MauiTrainApp.ViewModels.Items"
    xmlns:viewModels="clr-namespace:MauiTrainApp.ViewModels"
    x:DataType="viewModels:WorkoutViewModel"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Margin="{StaticResource Space6}" Style="{StaticResource Card}">
            <VerticalStackLayout Spacing="{StaticResource Space3}">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="{StaticResource Space1}">
                        <Label Style="{StaticResource SectionCaption}" Text="{Binding DayText}" />
                        <Label Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                    </VerticalStackLayout>
                    <Label
                        Grid.Column="1"
                        Style="{StaticResource Numeric}"
                        Text="{Binding ElapsedText}"
                        VerticalOptions="Center" />
                </Grid>

                <ProgressBar Progress="{Binding Progress}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Style="{StaticResource Muted}" Text="{Binding ProgressText}" />
                    <Label Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding VolumeText}" />
                </Grid>

            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1" x:Name="ExercisesScroll">
            <VerticalStackLayout Padding="17,0" Spacing="{StaticResource Space3}">

            <VerticalStackLayout
                x:Name="ExercisesLayout"
                BindableLayout.ItemsSource="{Binding Exercises}"
                Spacing="{StaticResource Space3}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="items:WorkoutExerciseViewModel">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="{StaticResource Space3}">

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:WorkoutViewModel}}, Path=ToggleExerciseCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <Border
                                        Padding="0"
                                        BackgroundColor="{StaticResource Accent900}"
                                        HeightRequest="28"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        WidthRequest="28">
                                        <Label
                                            FontSize="13"
                                            HorizontalOptions="Center"
                                            Text="{Binding BadgeText}"
                                            TextColor="{StaticResource Accent300}"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space1}">
                                        <Label Style="{StaticResource CardTitle}" Text="{Binding ExerciseName}" />
                                        <Label Style="{StaticResource Muted}" Text="{Binding SummaryText}" />
                                    </VerticalStackLayout>

                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:WorkoutViewModel}}, Path=CompleteExerciseCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding IsCompleted, Converter={StaticResource InvertedBool}}"
                                        Style="{StaticResource GhostButton}"
                                        Text="Отметить всё" />
                                </Grid>

                                <Grid
                                    ColumnDefinitions="Auto,Auto,*,Auto,Auto,*,Auto,Auto,Auto"
                                    ColumnSpacing="4"
                                    IsVisible="{Binding IsExpanded}">
                                    <Label
                                        Grid.Column="2"
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="кг"
                                        TextColor="{StaticResource Neutral500}" />
                                    <Label
                                        Grid.Column="5"
                                        FontSize="10"
                                        HorizontalTextAlignment="Center"
                                        Text="повт"
                                        TextColor="{StaticResource Neutral500}" />
                                </Grid>

                                <VerticalStackLayout
                                    BindableLayout.ItemsSource="{Binding WorkingSets}"
                                    IsVisible="{Binding IsExpanded}"
                                    Spacing="{StaticResource Space3}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="items:WorkingSetViewModel">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="4">

                                                <Label
                                                    Grid.Column="0"
                                                    Style="{StaticResource Muted}"
                                                    HorizontalTextAlignment="Center"
                                                    Text="{Binding Number}"
                                                    VerticalOptions="Center"
                                                    WidthRequest="14" />

                                                <Button
                                                    Grid.Column="1"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:WorkoutViewModel}}, Path=DecreaseWeightCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource StepButtonSmall}"
                                                    Text="−" />
                                                <controls:NumericEntry
                                                    Grid.Column="2"
                                                    Completed="OnWorkingSetEntryCompleted"
                                                    Style="{StaticResource NumberEntry}"
                                                    Text="{Binding WeightText, Mode=TwoWay}"
                                                    Unfocused="OnWorkingSetEntryUnfocused" />
                                                <Button
                                                    Grid.Column="3"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:WorkoutViewModel}}, Path=IncreaseWeightCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource StepButtonSmall}"
                                                    Text="+" />

                                                <Button
                                                    Grid.Column="4"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:WorkoutViewModel}}, Path=DecreaseRepsCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource StepButtonSmall}"
                                                    Text="−" />
                                                <controls:NumericEntry
                                                    Grid.Column="5"
                                                    Completed="OnWorkingSetEntryCompleted"
                                                    Style="{StaticResource NumberEntry}"
                                                    Text="{Binding RepsText, Mode=TwoWay}"
                                                    Unfocused="OnWorkingSetEntryUnfocused" />
                                                <Button
                                                    Grid.Column="6"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:WorkoutViewModel}}, Path=IncreaseRepsCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource StepButtonSmall}"
                                                    Text="+" />

                                                <Button
                                                    Grid.Column="7"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:WorkoutViewModel}}, Path=ToggleWorkingSetCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource StepButtonSmall}"
                                                    Text="{Binding IsCompleted, Converter={StaticResource WorkingSetMark}}" />

                                                <Button
                                                    Grid.Column="8"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:WorkoutViewModel}}, Path=RemoveWorkingSetCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Style="{StaticResource DeleteButton}"
                                                    Text="🗑" />

                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <Button
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:WorkoutViewModel}}, Path=AddWorkingSetCommand}"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding IsExpanded}"
                                    Style="{StaticResource GhostButton}"
                                    Text="+ Подход" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

                <Button
                    Command="{Binding StartPickingCommand}"
                    IsVisible="{Binding IsLoaded}"
                    Style="{StaticResource SecondaryButton}"
                    Text="+ Упражнение" />

                <Border IsVisible="{Binding IsPicking}" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="{StaticResource Space3}">

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Style="{StaticResource SectionCaption}" Text="Выберите упражнение" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding CancelPickingCommand}"
                                Style="{StaticResource GhostButton}"
                                Text="Закрыть" />
                        </Grid>

                        <VerticalStackLayout
                            BindableLayout.ItemsSource="{Binding PickerExercises}"
                            Spacing="{StaticResource Space2}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="items:ExerciseRowViewModel">
                                    <Border
                                        Padding="10,8"
                                        BackgroundColor="{StaticResource BackgroundElevated}"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:WorkoutViewModel}}, Path=PickExerciseCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}">
                                            <Label Text="{Binding Name}" VerticalOptions="Center" />
                                            <controls:TagChip
                                                Grid.Column="1"
                                                Kind="Outline"
                                                Text="{Binding MuscleName}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout
            Grid.Row="2"
            Padding="{StaticResource Space6}"
            IsVisible="{Binding IsLoaded}"
            Spacing="{StaticResource Space3}">
            <Button
                Command="{Binding CompleteWorkoutCommand}"
                Style="{StaticResource PrimaryButton}"
                Text="{Binding CompleteText}" />
            <Button
                Command="{Binding CancelWorkoutCommand}"
                Style="{StaticResource GhostButton}"
                Text="Отменить тренировку" />
        </VerticalStackLayout>

    </Grid>

</base:ContentPageBase>
