<?xml version="1.0" encoding="utf-8" ?>
<base:ContentPageBase
    x:Class="MauiTrainApp.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:MauiTrainApp.Views.Base"
    xmlns:controls="clr-namespace:MauiTrainApp.Controls"
    xmlns:items="clr-namespace:MauiTrainApp.ViewModels.Items"
    xmlns:viewModels="clr-namespace:MauiTrainApp.ViewModels"
    x:DataType="viewModels:HistoryViewModel"
    Title="История">

    <Grid RowDefinitions="Auto,*">

        <ActivityIndicator
            Grid.Row="0"
            HeightRequest="3"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}" />

        <VerticalStackLayout
            Grid.Row="1"
            Padding="{StaticResource Space8}"
            IsVisible="{Binding IsEmpty}"
            Spacing="{StaticResource Space4}"
            VerticalOptions="Center">
            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource CardTitle}"
                Text="Тренировок ещё не было" />
            <Label
                HorizontalTextAlignment="Center"
                Style="{StaticResource Muted}"
                Text="Начните тренировку по плану — она появится здесь" />
        </VerticalStackLayout>

        <RefreshView
            Grid.Row="1"
            Command="{Binding LoadCommand}"
            IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
            IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBool}}">

            <ScrollView>
                <VerticalStackLayout Padding="{StaticResource Space6}" Spacing="{StaticResource Space6}">

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource Space3}">
                        <controls:StatTile Caption="Тренировок" Value="{Binding WorkoutCountText}" />
                        <controls:StatTile
                            Grid.Column="1"
                            Caption="Объём"
                            Value="{Binding VolumeText}" />
                        <controls:StatTile
                            Grid.Column="2"
                            Caption="В среднем"
                            Value="{Binding AverageDurationText}" />
                    </Grid>

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Months}"
                        Spacing="{StaticResource Space6}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="items:WorkoutMonthViewModel">
                                <VerticalStackLayout Spacing="{StaticResource Space3}">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Style="{StaticResource SectionCaption}" Text="{Binding Title}" />
                                        <Label
                                            Grid.Column="1"
                                            Style="{StaticResource Muted}"
                                            Text="{Binding SummaryText}" />
                                    </Grid>

                                    <VerticalStackLayout
                                        BindableLayout.ItemsSource="{Binding Workouts}"
                                        Spacing="{StaticResource Space3}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="items:WorkoutRowViewModel">
                                                <Border Style="{StaticResource Card}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:HistoryViewModel}}, Path=OpenWorkoutCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space4}">

                                                        <Label
                                                            Grid.Column="0"
                                                            HorizontalTextAlignment="Center"
                                                            Style="{StaticResource Muted}"
                                                            Text="{Binding DayShortText}"
                                                            VerticalOptions="Center"
                                                            WidthRequest="44" />

                                                        <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space1}">
                                                            <Label Text="{Binding Title}" />
                                                            <Label Style="{StaticResource Muted}" Text="{Binding MetaText}" />
                                                        </VerticalStackLayout>

                                                        <controls:TagChip
                                                            Grid.Column="2"
                                                            Kind="{Binding TagKind}"
                                                            Text="{Binding TagText}"
                                                            VerticalOptions="Center" />

                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

        </RefreshView>

    </Grid>

</base:ContentPageBase>
