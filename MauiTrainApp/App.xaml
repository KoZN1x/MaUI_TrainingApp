<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiTrainApp"
             xmlns:converters="clr-namespace:MauiTrainApp.Converters"
             x:Class="MauiTrainApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:WorkingSetMarkConverter x:Key="WorkingSetMark" />
            <converters:InvertedBoolConverter x:Key="InvertedBool" />
            <converters:MuscleGroupConverter x:Key="MuscleGroupName" />
            <converters:VolumeConverter x:Key="Volume" />
            <converters:DurationConverter x:Key="Duration" />
            <converters:WorkoutDayConverter x:Key="WorkoutDay" />
            <converters:PercentConverter x:Key="Percent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
