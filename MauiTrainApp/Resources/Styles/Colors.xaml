<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Background">#161826</Color>
    <Color x:Key="BackgroundElevated">#191C2B</Color>
    <Color x:Key="Surface">#232532</Color>
    <Color x:Key="TextPrimary">#E9E9ED</Color>
    <Color x:Key="Divider">#2E3140</Color>

    <Color x:Key="Accent">#9184D9</Color>
    <Color x:Key="Accent100">#F5F4FF</Color>
    <Color x:Key="Accent200">#E7E5FE</Color>
    <Color x:Key="Accent300">#D2CEFD</Color>
    <Color x:Key="Accent400">#B5ABFC</Color>
    <Color x:Key="Accent500">#968AE0</Color>
    <Color x:Key="Accent600">#796CBF</Color>
    <Color x:Key="Accent700">#5D5294</Color>
    <Color x:Key="Accent800">#423A6A</Color>
    <Color x:Key="Accent900">#2B2741</Color>

    <Color x:Key="Neutral100">#F3F5FE</Color>
    <Color x:Key="Neutral200">#E4E7F5</Color>
    <Color x:Key="Neutral300">#CFD3E5</Color>
    <Color x:Key="Neutral400">#B2B6CA</Color>
    <Color x:Key="Neutral500">#9397AB</Color>
    <Color x:Key="Neutral600">#75798C</Color>
    <Color x:Key="Neutral700">#595D6C</Color>
    <Color x:Key="Neutral800">#3F424D</Color>
    <Color x:Key="Neutral900">#292B31</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Divider}" />

</ResourceDictionary>
